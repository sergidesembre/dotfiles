[init]
    defaultBranch = main

[core]
    editor = nano
    autocrlf = input
    trustctime = false
    whitespace = trailing-space,space-before-tab
    excludesfile = ~/Developer/personal/dotfiles/git/ignore

[color]
    ui = auto

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]
    meta = yellow bold
    commit = green bold
    frag = magenta bold
    old = red bold
    new = green bold
    whitespace = red reverse

[color "status"]
    added = green
    changed = yellow
    untracked = red

[help]
    autocorrect = prompt   # pregunta antes de ejecutar el comando corregido

[apply]
    whitespace = fix

[push]
    default = current

[commit]
    template = ~/Developer/personal/dotfiles/git/message

# Firma de commits con SSH a través de 1Password
# (la clave y gpgsign = true van en cada perfil)
[gpg]
    format = ssh

[gpg "ssh"]
    program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign

# Nombre y email según la carpeta (archivos fuera del repo)
[includeIf "gitdir:~/Developer/personal/"]
    path = ~/Developer/personal/.gitconfig.profile

[includeIf "gitdir:~/Developer/work/"]
    path = ~/Developer/work/.gitconfig.profile
